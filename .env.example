# Required in every deployed environment. Use at least 32 random bytes.
HSE_SESSION_SECRET=replace-with-a-long-random-secret

# Foundation-only worker login adapter. Keep disabled in production until the
# production identity/authentication provider is connected.
HSE_ENABLE_WORKER_DEMO_AUTH=false
HSE_WORKER_DEMO_EMAIL=worker@example.com
HSE_WORKER_DEMO_PASSWORD=replace-with-a-strong-local-password
HSE_WORKER_DEMO_NAME=Demo Worker
HSE_WORKER_DEMO_ID=HSE-WRK-000001

# Enables the non-persistent dashboard projection used only for visual and
# workflow validation before the persistence milestone is connected.
HSE_USE_WORKER_DEMO_DATA=false
