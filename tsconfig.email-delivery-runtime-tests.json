{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowJs": true,
    "checkJs": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    },
    "outDir": ".email-delivery-runtime-test-dist",
    "rootDir": "src/lib",
    "types": ["node"],
    "lib": ["ES2022"],
    "noEmitOnError": true
  },
  "include": [
    "src/lib/auth/auth-domain.ts",
    "src/lib/authorization/authorization-domain.ts",
    "src/lib/authorization/authorization-context-domain.ts",
    "src/lib/authorization/tenant-scoped-resource-domain.ts",
    "src/lib/authorization/tenant-scoped-command-guard.ts",
    "src/lib/audit/audit-domain.ts",
    "src/lib/audit/audit-repository.ts",
    "src/lib/outbox/outbox-domain.ts",
    "src/lib/outbox/outbox-repository.ts",
    "src/lib/email-delivery/email-delivery-domain.ts",
    "src/lib/email-delivery/email-delivery-adapter.ts",
    "src/lib/email-delivery/email-delivery-repository.ts",
    "src/lib/email-delivery/email-delivery-handler.ts",
    "src/lib/config/environment.ts",
    "src/lib/config/server-environment.ts",
    "src/lib/database/database.ts",
    "src/lib/database/pglite-path.mjs"
  ]
}
