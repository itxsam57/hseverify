{
  "name": "hseverify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "validate:env": "node scripts/validate-environment.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:rollback": "node scripts/db-rollback.mjs",
    "db:import-profiles": "node scripts/import-file-profiles.mjs",
    "setup:local": "npm run validate:env && npm run db:migrate",
    "check:routes": "node scripts/check-worker-routes.mjs",
    "test:profile": "node scripts/run-profile-tests.mjs",
    "test:platform": "node --test tests/platform/platform-foundation.test.mjs",
    "preview:smoke": "node scripts/smoke-preview.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:record": "node scripts/record-release.mjs",
    "check": "npm run validate:env && npm run check:routes && npm run test:profile && npm run test:platform && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@next/env": "16.2.12",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3"
  }
}
