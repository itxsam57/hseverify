{
  "name": "hseverify",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/run-development.mjs",
    "build": "node scripts/build-production.mjs",
    "start": "next start",
    "lint": "eslint .",
    "clean:next": "node scripts/clean-next-generated.mjs",
    "typecheck": "node scripts/typecheck-project.mjs",
    "validate:env": "node scripts/validate-environment.mjs",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:status": "node scripts/db-status.mjs",
    "db:rollback": "node scripts/db-rollback.mjs",
    "db:import-profiles": "node scripts/import-file-profiles.mjs",
    "setup:local": "npm run validate:env && npm run db:migrate",
    "check:routes": "node scripts/check-worker-routes.mjs",
    "check:authorization": "node scripts/check-authorization-foundation.mjs",
    "check:tenant-scope": "node scripts/check-tenant-scope-guards.mjs",
    "check:design-system": "node scripts/check-design-system.mjs",
    "check:ux": "node scripts/check-profile-ux.mjs",
    "check:dependencies": "node scripts/check-secure-dependencies.mjs",
    "check:engineering": "node scripts/check-engineering-automation.mjs",
    "test:profile": "node scripts/run-profile-tests.mjs",
    "test:auth": "node scripts/run-auth-tests.mjs",
    "test:authorization": "node scripts/run-authorization-tests.mjs",
    "test:platform": "node --test tests/platform/platform-foundation.test.mjs",
    "test:auth-platform": "node --test tests/platform/authentication-foundation.test.mjs",
    "test:authorization-platform": "node --test tests/platform/authorization-tenant-foundation.test.mjs tests/platform/authorization-policy-ceiling.test.mjs tests/platform/authorization-membership-context.test.mjs tests/platform/authorization-session-context.test.mjs",
    "test:tenant-scope": "node --test tests/platform/authorization-tenant-scope-repository.test.mjs tests/platform/authorization-tenant-scope-concurrency.test.mjs",
    "test:registration-platform": "node --test tests/platform/worker-registration-foundation.test.mjs tests/platform/worker-registration-concurrency.test.mjs tests/platform/worker-registration-routes.test.mjs tests/platform/worker-registration-flow-sql.test.mjs",
    "test:registration-owner-repair": "node --test tests/platform/worker-registration-owner-repair.test.mjs",
    "test:auth-completion": "node --test tests/platform/authentication-completion.test.mjs tests/platform/authentication-invitation-expiry.test.mjs tests/platform/authentication-portal-isolation.test.mjs tests/platform/authentication-signed-out-proxy.test.mjs tests/platform/authentication-failure-state-sql.test.mjs",
    "test:profile-overflow": "node --test tests/platform/profile-overflow-contract.test.mjs",
    "test:preview-copy": "node --test tests/platform/preview-bundle-copy.test.mjs",
    "test:next-system": "node --test tests/platform/next-build-system.test.mjs",
    "test:engineering": "node --test tests/engineering/handoff-domain.test.mjs",
    "test:development": "node scripts/smoke-development.mjs",
    "test:portal-redirects": "node scripts/smoke-signed-out-portal-redirects.mjs",
    "test:runtime-db": "node scripts/smoke-application-pglite.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "preview:smoke": "node scripts/smoke-preview.mjs",
    "release:manifest": "node scripts/create-release-manifest.mjs",
    "release:record": "node scripts/record-release.mjs",
    "test:unit": "npm run test:profile && npm run test:auth && npm run test:authorization && npm run test:engineering",
    "test:integration": "npm run test:platform && npm run test:auth-platform && npm run test:authorization-platform && npm run test:tenant-scope && npm run test:registration-platform && npm run test:registration-owner-repair && npm run test:auth-completion",
    "test:e2e": "npm run test:development && npm run test:portal-redirects && npm run test:runtime-db",
    "verify:quick": "npm run validate:env && npm run check:engineering && npm run check:routes && npm run check:authorization && npm run check:tenant-scope && npm run check:design-system && npm run check:ux && npm run test:unit && npm run typecheck && npm run lint",
    "verify:affected": "node scripts/verify-affected.mjs",
    "verify:full": "node scripts/run-engineering-gate.mjs",
    "report:handoff": "node scripts/report-manual-handoff.mjs",
    "check": "npm run validate:env && npm run check:engineering && npm run check:routes && npm run check:authorization && npm run check:tenant-scope && npm run check:design-system && npm run check:ux && npm run check:dependencies && npm run audit:production && npm run test:engineering && npm run test:profile && npm run test:auth && npm run test:authorization && npm run test:platform && npm run test:auth-platform && npm run test:authorization-platform && npm run test:tenant-scope && npm run test:registration-platform && npm run test:registration-owner-repair && npm run test:auth-completion && npm run test:profile-overflow && npm run test:preview-copy && npm run test:next-system && npm run typecheck && npm run lint && npm run test:development && npm run test:portal-redirects && npm run test:runtime-db && npm run build"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@next/env": "16.2.12",
    "next": "16.2.12",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.12",
    "typescript": "6.0.3"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.3"
  }
}
